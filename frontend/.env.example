# Frontend build/dev configuration.
#
# Anything here that Vite exposes to the browser is public — VITE_* values end
# up in the bundle. Secrets belong in the two shell variables at the bottom,
# which are read by vite.config.js in Node and never shipped.

# Where the Django REST API lives. Defaults to /api, which Vite proxies in dev.
# VITE_API_BASE=/api

# Where the assistant's RAG service lives, from the browser's point of view.
# Defaults to /ai/api/v1 — a path on this origin, proxied to the service, so
# the service's API key stays on the server. Point this elsewhere only if you
# are deliberately exposing the service directly.
# VITE_AI_BASE=/ai/api/v1

# --- dev-server only, never bundled --------------------------------------
# The RAG service's address and API key. vite.config.js attaches the key to
# every proxied /ai request.
# AI_SERVICE_URL=http://127.0.0.1:8080
# AI_SERVICE_API_KEY=
