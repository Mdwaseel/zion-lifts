# Loaded by `vite build --mode static` (npm run build:static).
# The site reads its content from the JSON snapshot in public/api instead of
# a running Django API, and the forms explain that they cannot send.
VITE_STATIC_API=1

# The street map's tile key (CARTO). Public by nature — it is sent with every
# tile request — and .env.local is not present on the Vercel build, so the
# live site needs it here.
VITE_MAP_API_KEY=cb1_3zzl_1_7015aabac2d67ac562ea4b26
