# Copy to backend/.env and fill in for anything other than local development.
# backend/.env is gitignored — never commit real secrets.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origins allowed to call the API (the Vite dev server, then the real domain)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# The single origin the site is served from. Added to the two allow-lists above
# automatically, so it cannot be set in one and forgotten in the other.
FRONTEND_URL=http://localhost:5173

# --- authentication --------------------------------------------------------
# Cookie names. Change them only if something else on the domain already
# uses these; the React client never reads them, it just sends them.
JWT_ACCESS_COOKIE=access_token
JWT_REFRESH_COOKIE=refresh_token

# Access tokens are short: they are presented on every request and are valid
# until they expire, so this window is their whole blast radius. Refresh tokens
# are long because their only job is to avoid asking for the password again —
# they are scoped to /api/accounts/, rotated on use and revocable.
JWT_ACCESS_LIFETIME_MINUTES=15
JWT_REFRESH_LIFETIME_DAYS=7

# Optional. Defaults to DJANGO_SECRET_KEY. Set it separately if you want to be
# able to invalidate every session by rotating one key without also breaking
# signed cookies and password-reset links.
JWT_SIGNING_KEY=

# Cookie flags. Secure defaults to "off in DEBUG, on otherwise", and the
# settings module refuses to boot with DEBUG=0 and AUTH_COOKIE_SECURE=false.
AUTH_COOKIE_SECURE=false
# Lax is correct while the site and the API share an origin, which they do both
# in development (Vite proxies /api) and in production (nginx). Only use None —
# which also requires Secure — if the API really is on another site.
AUTH_COOKIE_SAMESITE=Lax
# Leave blank unless cookies must be shared across subdomains.
AUTH_COOKIE_DOMAIN=

# How many reverse proxies sit in front of Django. This decides which address a
# rate limit counts against, so it is a security setting, not a detail: left
# wrong, DRF keys the bucket on the client-supplied X-Forwarded-For header and
# an attacker varying that header is never throttled at all.
#   0 = Django is reached directly (the default, and correct in development)
#   1 = one nginx in front, which is the deployment described in the README
NUM_PROXIES=0

# Rate limits. Loose enough for someone mistyping a password, tight enough to
# make a wordlist impractical. login is per IP, login_account per address.
LOGIN_RATE_LIMIT=10/minute
LOGIN_ACCOUNT_RATE_LIMIT=12/hour
CAPTCHA_RATE_LIMIT=30/minute

# CAPTCHA. Short window, few guesses, single use.
CAPTCHA_TTL_SECONDS=300
CAPTCHA_MAX_ATTEMPTS=3
CAPTCHA_LENGTH=5

# Security log. Records outcomes and actors — never passwords, tokens, cookie
# values or CAPTCHA answers. Leave the file blank to log to stdout.
AUTH_LOG_LEVEL=INFO
AUTH_LOG_FILE=

# --- cache -----------------------------------------------------------------
# Required in production. Throttle buckets and CAPTCHA challenges must be
# visible to every worker; the in-memory fallback is per-process, so with more
# than one gunicorn worker a CAPTCHA would validate only on the worker that
# issued it and rate limits would be multiplied by the worker count.
REDIS_URL=

# --- Where new enquiries and service requests are emailed ------------------
# Leave the console backend in development: mail is printed, never sent.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=website@zionlifts.com
ENQUIRY_NOTIFY_TO=sales@zionlifts.com,service@zionlifts.com

# --- Knowledge base / ai_service --------------------------------------------
# The broker Django shares with the ingestion worker. Defaults to REDIS_URL,
# which is also the cache backend, so a single Redis serves both.
# CELERY_BROKER_URL=redis://localhost:6379/0

# Stamped onto every DocumentVersion at upload, so the record stays true after
# the AI service is reconfigured. Must match ai_service's own EMBEDDING_MODEL
# and EMBEDDING_MODEL_VERSION, or a version will be recorded as built with an
# embedding it was not built with.
# AI_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# AI_EMBEDDING_MODEL_VERSION=v1

# Upload ceiling for knowledge documents, in bytes. Mirrors MAX_UPLOAD_BYTES on
# the AI side; enforced here, because this is where the upload arrives.
# KNOWLEDGE_MAX_UPLOAD_BYTES=26214400

# The shared secret on /api/internal/knowledge/, where the ingestion worker
# reports progress and fetches stored documents. Must equal ai_service's
# AI_SERVICE_INTERNAL_TOKEN exactly.
#
# It is not a user credential and must never be used as one. Unset, the internal
# routes refuse every request — which means uploads are accepted, queued, and
# then sit in PROCESSING for ever with nothing to explain it. Required when
# DJANGO_DEBUG=0.
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AI_SERVICE_INTERNAL_TOKEN=

# --- Observability -----------------------------------------------------------
# json in production, console in development. Both redact: secrets are removed
# and content (document text, questions, answers) is reduced to a length and a
# hash rather than printed.
LOG_FORMAT=console
LOG_LEVEL=INFO

# Must match REQUEST_ID_HEADER in ai_service/.env, or one upload produces two
# unconnected halves of a trace.
REQUEST_ID_HEADER=X-Request-ID

# How long an ingestion job may stay in flight before the operations dashboard
# calls it stale. Detection only: nothing is failed automatically, because a
# dead worker and a slow one look identical from the outside and only one is
# safe to give up on.
INGESTION_STALE_AFTER_SECONDS=1800

# Reading ai_service's provider health from the admin operations dashboard.
# AI_SERVICE_OPS_TOKEN is a *different* secret from AI_SERVICE_INTERNAL_TOKEN:
# that one is what the worker presents to Django, this is what Django presents
# to ai_service, and it must equal ai_service's INTERNAL_TOKEN.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_OPS_TOKEN=
