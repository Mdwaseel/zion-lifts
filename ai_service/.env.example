# --- App ---
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
API_PREFIX=/api/v1

# --- Security ---
# Comma-separated. Leave blank to disable API-key auth in local development.
API_KEYS=
INTERNAL_TOKEN=change-me
CORS_ORIGINS=*

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# --- Reranking ---
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Retrieval ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
HYBRID_ALPHA=0.5
QUERY_REWRITE_ENABLED=true

# --- LLM (at least one key required) ---
LLM_PROVIDER_ORDER=gemini,groq,openai
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
