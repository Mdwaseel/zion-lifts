# ai_service configuration.
#
# Every name below is a field on app.core.config.Settings, spelled exactly.
# The model is FLAT: there is no `SECTION__FIELD` nesting, and a name written
# that way binds to nothing. The service refuses to start if it finds one,
# rather than falling back to a default and pretending it was configured.
#
# Lists are comma-separated, not JSON:  API_KEYS=key-one,key-two
#
# Copy to .env and fill in. Never commit a filled-in .env.

# --- App ---------------------------------------------------------------------
# development | test | staging | production
# staging and production are validated on start: see "Deployment" at the bottom.
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
API_PREFIX=/api/v1

# --- Observability -----------------------------------------------------------
# In-process counters and histograms, read back from /api/v1/ops/metrics.
# Disabling makes every record a no-op rather than removing the call sites.
METRICS_ENABLED=true
# The header a correlation id arrives on and is echoed back in. Must match
# REQUEST_ID_HEADER on the Django side, or one upload produces two unconnected
# halves of a trace.
REQUEST_ID_HEADER=X-Request-ID
# An inbound id is echoed into every log line, so anything longer or stranger
# than an id is replaced with a generated one rather than trusted.
REQUEST_ID_MAX_LENGTH=64
# How long a job may run before an operator should look at it. Detection only —
# nothing is failed automatically on this signal.
INGESTION_STALE_AFTER_SECONDS=1800

# --- Security ----------------------------------------------------------------
# Callers present these as X-API-Key. Empty disables the check, which is fine
# locally and rejected in staging/production.
API_KEYS=
# Guards /internal/*. Must be 32+ characters outside development.
INTERNAL_TOKEN=change-me
# Browser origins allowed to call this service directly. In this deployment the
# site talks to /ai through its own proxy, so "*" is only a local convenience.
CORS_ORIGINS=*

# --- Vector store ------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# The corpus indexed before knowledge bases existed. Collections created for a
# knowledge base are named by CollectionNameBuilder and are not set here.
QDRANT_COLLECTION=documents
QDRANT_TIMEOUT=30

# --- Broker / worker ---------------------------------------------------------
# Shared with Django: both sides must point at the same Redis, including the
# database number. A mismatch here is silent — Django reports uploads as queued
# and the worker sits idle on an empty queue.
REDIS_URL=

# Only set these to split broker and results across instances; unset, both
# follow REDIS_URL.
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# Must match apps/knowledge/dispatch.py:QUEUE on the Django side.
CELERY_TASK_QUEUE=ai_ingestion

# One at a time, deliberately: each worker child loads its own copy of the
# embedding model and the cross-encoder, so concurrency multiplies memory
# rather than throughput. Measure resident set size under real documents before
# raising it.
CELERY_WORKER_CONCURRENCY=1
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# Soft raises an exception the pipeline can report; hard kills the child.
CELERY_TASK_SOFT_TIME_LIMIT=1500
CELERY_TASK_TIME_LIMIT=1800

# Only transient failures are retried — see app/core/errors.py.
CELERY_TASK_MAX_RETRIES=3
CELERY_RETRY_BACKOFF=30
CELERY_RETRY_BACKOFF_MAX=600

# --- Document storage --------------------------------------------------------
# How the worker turns a file_reference into bytes.
#
#   http   asks the backend over its internal route. Assumes nothing about
#          where the worker runs. The default, and the right answer unless you
#          have deliberately arranged otherwise.
#   local  reads a directory that really is the same volume Django writes to.
#          Faster, and wrong in a way that fails every ingestion with
#          DOCUMENT_NOT_FOUND if the volume is not actually shared.
DOCUMENT_STORAGE=http
# Required when DOCUMENT_STORAGE=local: where Django's MEDIA_ROOT is mounted
# inside this container.
# DOCUMENT_STORAGE_ROOT=/var/lib/zion/uploads

# --- Backend callback --------------------------------------------------------
# Where the worker reports progress. Without it a run does all its work and
# tells nobody, leaving every document stuck in PROCESSING.
BACKEND_URL=http://localhost:8000
# The shared secret on /api/internal/knowledge/. Must equal Django's
# AI_SERVICE_INTERNAL_TOKEN, and must be 32+ characters outside development.
AI_SERVICE_INTERNAL_TOKEN=
BACKEND_TIMEOUT=15
BACKEND_RETRIES=3

# --- Embeddings --------------------------------------------------------------
# Where vectors come from:
#   auto  - the Hugging Face API when HF_API_TOKEN is set, otherwise in-process
#   api   - always the API; refuses to start without a token
#   local - always in-process, which needs requirements-local-models.txt
#           (sentence-transformers + torch) installed in the image
EMBEDDING_PROVIDER=auto

# A read token from https://huggingface.co/settings/tokens. Required for the
# API provider. Never commit a real one — this file is an example.
HF_API_TOKEN=
# The router host. The older api-inference.huggingface.co no longer resolves,
# so a value copied from older documentation fails DNS rather than 404s.
HF_API_BASE=https://router.huggingface.co/hf-inference/models
HF_API_TIMEOUT=30
# A serverless model that has gone cold answers 503 for up to a minute while it
# is loaded onto a worker. That is the first request of the day, not an outage,
# so it is retried rather than failed.
HF_API_MAX_RETRIES=3
HF_API_BACKOFF=1.0

# The model everything is indexed and queried with. HF_EMBEDDING_MODEL is
# accepted as an alias for this same setting.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Part of the collection name. Bump it when the same model name starts
# producing different vectors, so new writes land in a new collection instead
# of being compared against vectors they do not match.
EMBEDDING_MODEL_VERSION=v1
# The width the start-up collection is created at. The API provider measures
# the model's real width on its first call and corrects this if they disagree.
EMBEDDING_DIM=384
# Local provider only; the API provider has no device to place.
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_SIZE=4096

# --- Reranking ---------------------------------------------------------------
# The cross-encoder runs in-process and needs requirements-local-models.txt.
# With the default image it is not installed, and leaving this true gets you one
# error at start-up and fusion-ordered results. Set it to false to mean it.
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Assistant routing ---------------------------------------------------------
# The intelligent router in front of retrieval: it classifies each question and
# decides which sources may answer it. False restores the pre-routing behaviour
# — retrieve for every question, refuse when grounding is weak — which is the
# one-restart way back if the routed answers are worse in production.
QUERY_ROUTING_ENABLED=true
# Spend an LLM call to break a tie when the rule classifier is unsure. Off by
# default: it is a second round trip before retrieval starts, and an unsure
# classification already resolves to the safe, widest intent.
INTENT_LLM_TIEBREAK=false
# How much of the context-selection objective is relevance rather than novelty.
# Lower it if answers repeat themselves; raise it if they wander.
CONTEXT_DIVERSITY_LAMBDA=0.7

# --- Website index -------------------------------------------------------------
# Where the assistant reads the site's own content, so it can answer "where do I
# find X?" and link to real pages. Defaults to BACKEND_URL. Leave everything
# unset and the index holds the static route table only: the assistant can still
# link to /lifts and /contact, and simply cannot name individual products.
# WEBSITE_BASE_URL=http://localhost:8002
WEBSITE_INDEX_ENABLED=true
# A request never waits on this; the rebuild happens beside the request path and
# a failed one keeps serving the last good index.
WEBSITE_INDEX_TTL_SECONDS=900
WEBSITE_INDEX_TIMEOUT=10

# --- Chunking ----------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval ---------------------------------------------------------------
# Candidates fetched per retriever, then fused, then reranked to the final set.
DENSE_TOP_K=80
SPARSE_TOP_K=80
FUSION_TOP_K=20
RERANK_TOP_K=5
# 1.0 = dense only, 0.0 = lexical only.
HYBRID_ALPHA=0.5
QUERY_REWRITE_ENABLED=true
# Ceiling on how much of a collection the lexical retriever will scan.
KEYWORD_SCAN_LIMIT=2000

# --- Grounding ---------------------------------------------------------------
# 0.0 means no floor, which is the behaviour this pipeline shipped with. Raise
# them to make the service refuse more readily rather than answer from weak
# evidence; watch the refusal rate after any change.
MIN_RETRIEVAL_SCORE=0.0
MIN_RERANK_SCORE=0.0
MIN_CONTEXT_DOCUMENTS=1
# Below CONFIDENCE_LOW the service refuses instead of generating.
CONFIDENCE_LOW=0.35
CONFIDENCE_HIGH=0.75
# Budget for retrieved passages, not the model's whole window.
MAX_CONTEXT_TOKENS=3000

# --- LLM ---------------------------------------------------------------------
# Tried in this order; the first one holding a credential wins, and a provider
# that keeps failing is taken out by the circuit breaker.
LLM_PROVIDER_ORDER=gemini,groq,openai
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=45

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set only when pointing the OpenAI client at a compatible gateway.
OPENAI_BASE_URL=

# --- Circuit breaker ---------------------------------------------------------
BREAKER_FAIL_THRESHOLD=3
BREAKER_RESET_SECONDS=60

# --- Uploads / indexing ------------------------------------------------------
MAX_UPLOAD_BYTES=26214400
# Points per Qdrant upsert, and texts per embedding call. Different limits:
# request size for the first, model memory for the second.
VECTOR_UPSERT_BATCH_SIZE=128
EMBED_BATCH_SIZE=64

# --- Deployment --------------------------------------------------------------
# With ENVIRONMENT=staging or production the service will not start unless:
#
#   BACKEND_URL         is set
#   AI_SERVICE_INTERNAL_TOKEN  is 32+ characters
#   DOCUMENT_STORAGE_ROOT      is set, when DOCUMENT_STORAGE=local
#   QDRANT_URL          names a real host (not localhost)
#   QDRANT_API_KEY      is set
#   REDIS_URL           is set and names a real host
#   API_KEYS            is non-empty
#   INTERNAL_TOKEN      is 32+ characters and not "change-me"
#   CORS_ORIGINS        does not contain "*"
#   DEBUG               is false
#   at least one provider in LLM_PROVIDER_ORDER has a credential
#
# All failures are reported together, by name, on the first line of the log.

# Which corpus a chat request that names no knowledge base reads. Leave unset
# only on a deployment whose content lives in QDRANT_COLLECTION (the collection
# that predates knowledge bases). Anything ingested through the Django models
# belongs to a knowledge base, and this must name it — otherwise the default
# search runs against an empty collection and the assistant refuses everything.
DEFAULT_KNOWLEDGE_BASE_ID=
